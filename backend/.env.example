DATABASE_URL="postgresql://cafe:cafe@localhost:5432/cafe_pi?schema=public"
JWT_SECRET="troque-este-segredo-em-producao"
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Azure opcional: mantenha false no desenvolvimento local sem recursos Azure.
AZURE_INTEGRATION_ENABLED=false
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=data-treated
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_QUEUE_NAME=data-file-available
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_MAX_DELIVERY_ATTEMPTS=5
