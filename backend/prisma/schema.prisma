generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum PerfilUsuario {
  ADMIN
  TECNICO
  PRODUTOR
}
enum TipoAlertaClimatica {
  TEMPERATURA_ALTA
  TEMPERATURA_BAIXA
  CHUVA_INTENSA
  ESTIAGEM
}
enum SeveridadeAlerta {
  INFO
  WARNING
  CRITICAL
}
enum CanalNotificacao {
  WEB
  PUSH
  EMAIL
}
model Usuario {
  id String @id @default(cuid())
  email String @unique
  senhaHash String
  nome String
  perfil PerfilUsuario @default(PRODUTOR)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  regioes RegiaoProdutora[] @relation("UsuarioRegioes")
  preferenciasNotificacao PreferenciaNotificacao[]
  notificacoes Notificacao[]
  dispositivosPush DispositivoPush[]
}
model RegiaoProdutora {
  id String @id @default(cuid())
  nomeRegiao String
  pais String
  latitude Float?
  longitude Float?
  codigoIbge String? @unique
  uf String?
  condicoes CondicaoClimatica[]
  climatologias ClimaRegiao[]
  safras SafraRendimento[]
  clusters ClusterRegiao[]
  compatibilidades CompatibilidadeCultura[]
  predicoes PrevisaoProdutividade[]
  alertasClimaticos AlertaClimatico[]
  usuarios Usuario[] @relation("UsuarioRegioes")
  @@index([uf])
  @@map("Regiao_Produtora")
}
model CondicaoClimatica {
  id String @id @default(cuid())
  regiaoId String
  data DateTime
  temperaturaMedia Float?
  precipitacao Float?
  umidade Float?
  radiacaoSolar Float?
  regiao RegiaoProdutora @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  @@index([regiaoId])
  @@map("Condicao_Climatica")
}
model Cultura {
  id String @id @default(cuid())
  nome String @unique
  slug String @unique
  safras SafraRendimento[]
  compatibilidades CompatibilidadeCultura[]
  metricas MetricaModelo[]
  predicoes PrevisaoProdutividade[]
  @@map("Cultura")
}
model SafraRendimento {
  id String @id @default(cuid())
  regiaoId String
  culturaId String
  anoColheita Int
  areaColhidaHa Float?
  producaoT Float?
  diasCrescimento Int?
  rendimentoToneladasHectare Float?
  regiao RegiaoProdutora @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  cultura Cultura @relation(fields: [culturaId], references: [id], onDelete: Restrict)
  @@unique([regiaoId, culturaId, anoColheita])
  @@index([regiaoId, culturaId])
  @@map("Safra_Rendimento")
}
model ClimaRegiao {
  id String @id @default(cuid())
  regiaoId String
  temperaturaMedia Float?
  temperaturaMin Float?
  chuvaMediaDiaria Float?
  chuvaAnual Float?
  umidade Float?
  radiacaoSolar Float?
  temperaturaJaneiro Float?
  temperaturaJulho Float?
  temperaturaMinimaJulho Float?
  chuvaEstacaoSeca Float?
  chuvaVerao Float?
  amplitudeTermica Float?
  contrasteChuva Float?
  periodoInicio Int?
  periodoFim Int?
  versaoDados String?
  importadoEm DateTime @default(now())
  regiao RegiaoProdutora @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  @@unique([regiaoId, versaoDados])
  @@index([regiaoId, versaoDados])
  @@map("Clima_Regiao")
}
model ClusterRegiao {
  id String @id @default(cuid())
  regiaoId String
  grupo Int
  nomeGrupo String?
  versaoModelo String
  regiao RegiaoProdutora @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  @@unique([regiaoId, versaoModelo])
  @@index([versaoModelo, grupo])
  @@map("Cluster_Regiao")
}
model ClusterPerfil {
  id String @id @default(cuid())
  grupo Int
  nomeGrupo String?
  quantidadeMunicipios Int
  variaveis Json
  versaoModelo String
  @@unique([grupo, versaoModelo])
  @@map("Cluster_Perfil")
}
model CompatibilidadeCultura {
  id String @id @default(cuid())
  regiaoId String
  culturaId String
  compatibilidade Float
  ranking Int?
  aptoReal Boolean?
  versaoModelo String
  aviso String?
  regiao RegiaoProdutora @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  cultura Cultura @relation(fields: [culturaId], references: [id], onDelete: Cascade)
  @@unique([regiaoId, culturaId, versaoModelo])
  @@index([culturaId, compatibilidade])
  @@map("Compatibilidade_Cultura")
}
model MetricaModelo {
  id String @id @default(cuid())
  culturaId String
  algoritmo String
  acuracia Float?
  acuraciaBalanceada Float?
  precisao Float?
  recall Float?
  f1 Float?
  auc Float?
  baseline Float?
  matrizConfusao Json?
  versaoModelo String
  executadoEm DateTime @default(now())
  cultura Cultura @relation(fields: [culturaId], references: [id], onDelete: Cascade)
  @@index([culturaId, versaoModelo])
  @@map("Metrica_Modelo")
}
model DataFileEvent {
  id String @id @default(cuid())
  eventId String @unique
  correlationId String
  sha256 String
  status String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  errorMessage String?
  @@index([status, receivedAt])
  @@map("Data_File_Event")
}
model AlertaClimatico {
  id String @id @default(cuid())
  regiaoId String
  tipo TipoAlertaClimatica
  severidade SeveridadeAlerta
  titulo String
  mensagem String
  valor Float?
  unidade String?
  observadoEm DateTime
  fonte String
  chaveSupressao String
  criadoEm DateTime @default(now())
  regiao RegiaoProdutora @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  notificacoes Notificacao[]
  @@unique([regiaoId, chaveSupressao])
  @@index([regiaoId, observadoEm])
  @@map("Alerta_Climatico")
}
model PreferenciaNotificacao {
  id String @id @default(cuid())
  usuarioId String
  regiaoId String?
  tipo TipoAlertaClimatica?
  canal CanalNotificacao
  habilitada Boolean @default(false)
  severidadeMinima SeveridadeAlerta @default(INFO)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@unique([usuarioId, regiaoId, tipo, canal])
  @@index([usuarioId, habilitada])
  @@map("Preferencia_Notificacao")
}
model DispositivoPush {
  id String @id @default(cuid())
  usuarioId String
  token String @unique
  plataforma String
  ativo Boolean @default(true)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId, ativo])
  @@map("Dispositivo_Push")
}
model Notificacao {
  id String @id @default(cuid())
  usuarioId String
  alertaId String
  canal CanalNotificacao
  status String @default("PENDING")
  titulo String
  mensagem String
  lidaEm DateTime?
  enviadaEm DateTime?
  erro String?
  criadoEm DateTime @default(now())
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  alerta AlertaClimatico @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  @@unique([usuarioId, alertaId, canal])
  @@index([usuarioId, status, criadoEm])
  @@map("Notificacao")
}
model PrevisaoProdutividade {
  id String @id @default(cuid())
  regiaoId String
  culturaId String
  anoPrevisto Int
  valor Float
  unidade String @default("t/ha")
  algoritmo String
  versaoModelo String
  versaoDados String?
  features Json?
  metricas Json?
  aviso String?
  executadoEm DateTime @default(now())
  regiao RegiaoProdutora @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  cultura Cultura @relation(fields: [culturaId], references: [id], onDelete: Restrict)
  @@unique([regiaoId, culturaId, anoPrevisto, versaoModelo])
  @@index([regiaoId, culturaId, anoPrevisto])
  @@index([versaoModelo])
  @@map("Previsao_Produtividade")
}
